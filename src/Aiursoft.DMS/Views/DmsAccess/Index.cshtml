@model Aiursoft.DMS.Models.DmsViewModels.DmsViewModel
<h1>@Localizer["DMS access"]</h1>
@if (Model.NewKey != null) { <div class="alert alert-warning"><div class="alert-message">@Localizer["Copy this Agent key now. The previous key is revoked."]<pre>@Model.NewKey</pre></div></div> }
<div class="row">
<div class="col-lg-6"><form asp-action="AgentKey" method="post" class="card"><div class="card-body"><h2>@Localizer["Agent identity"]</h2><label for="machine" class="form-label">@Localizer["Machine"]</label><select id="machine" name="machineId" class="form-select mb-2">@foreach (var m in Model.Machines) { <option value="@m.Id">@m.Name (@m.Id)</option> }</select><p>@Localizer["Issue a key after an approved machine registration. Issuing another key revokes the previous one."]</p><button class="btn btn-warning">@Localizer["Issue Agent key"]</button></div></form></div></div>
<p>@Localizer["Configure workflow risk permissions on roles. They apply to every machine in this DMS instance."]</p>
<a asp-controller="Roles" asp-action="Index">@Localizer["Roles"]</a>
