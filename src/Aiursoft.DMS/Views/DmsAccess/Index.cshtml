@model Aiursoft.DMS.Models.DmsViewModels.DmsViewModel

<div class="row">
    <div class="col-xl-9">
        <h1 class="h3 mb-2">@Localizer["Machine connection recovery"]</h1>
        <p class="text-body-secondary mb-4">@Localizer["Use this page if a machine's Agent connection key has been lost or exposed. Choose the machine to review the replacement steps."]</p>
        <div class="card">
            <div class="card-header"><h2 class="h5 mb-0">@Localizer["Registered machines"]</h2></div>
            @if (Model.Machines.Count == 0)
            {
                <div class="card-body text-body-secondary">@Localizer["No active machines are registered."]</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var machine in Model.Machines)
                    {
                        <li class="list-group-item px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <span class="fw-semibold me-2 text-break">@machine.Name</span>
                                @if (machine.LastSeen > DateTime.UtcNow.AddSeconds(-45))
                                {
                                    <span class="badge bg-success">@Localizer["Online"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["Offline"]</span>
                                }
                                @if (machine.LastSeen.HasValue)
                                {
                                    <div class="small text-body-secondary mt-1">@Localizer["Last seen"] @machine.LastSeen.Value.ToString("u")</div>
                                }
                            </div>
                            <a asp-action="RotateAgentKey" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Review key replacement"]</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
