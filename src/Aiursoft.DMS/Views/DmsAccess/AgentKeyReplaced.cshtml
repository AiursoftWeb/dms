@model Aiursoft.DMS.Models.DmsViewModels.AgentKeyRotationViewModel

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">@Localizer["Connection key replaced"]</h1>
                <p class="text-break mb-4">@Localizer["Machine"] <strong class="ms-2">@Model.MachineName</strong></p>
                <label for="new-agent-key" class="form-label">@Localizer["New Agent connection key"]</label>
                <div class="input-group mb-2">
                    <input id="new-agent-key" class="form-control font-monospace" type="text" value="@Model.NewKey" autocomplete="off" spellcheck="false" readonly />
                    <button id="copy-agent-key" type="button" class="btn btn-outline-secondary" hidden>@Localizer["Copy key"]</button>
                    <span id="agent-key-copied" hidden>@Localizer["Key copied"]</span>
                </div>
                <p class="text-body-secondary mb-4">@Localizer["Copy this key now. DMS shows it only once."]</p>
                <h2 class="h5 mb-3">@Localizer["Reconnect the Agent"]</h2>
                <ol class="mb-4 ps-3">
                    <li class="mb-2">@Localizer["On this machine, open the Agent configuration as an administrator and replace the value of AgentKey. The default path is shown below."] <code class="d-block text-break">sudoedit /var/lib/aiursoft-dms-agent/connection.json</code></li>
                    <li class="mb-2">@Localizer["Restart the Agent service."] <code class="d-block text-break">sudo systemctl restart dms-agent.service</code></li>
                    <li>@Localizer["Return to the machine list and check that the last seen time has updated."]</li>
                </ol>
                <a asp-action="Index" class="btn btn-primary">@Localizer["Back to registered machines"]</a>
            </div>
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/agent-key-copy.js" asp-append-version="true"></script>
}
