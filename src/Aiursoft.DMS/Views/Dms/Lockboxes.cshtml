@using Aiursoft.DMS.Contracts
@model Aiursoft.DMS.Models.DmsViewModels.DmsViewModel
<h1>@Localizer["Lockboxes"]</h1>
<div class="card"><div class="card-body table-responsive"><table class="table"><thead><tr><th>@Localizer["Request"]</th><th>@Localizer["Workflow"]</th><th>@Localizer["Risk"]</th><th>@Localizer["Decision"]</th><th>@Localizer["Created"]</th></tr></thead><tbody>
@foreach (var item in Model.Lockboxes)
{
    <tr><td><a asp-action="Lockbox" asp-route-id="@(new LockboxId(item.Id))">@(new LockboxId(item.Id))</a></td><td>@item.Definition</td><td>@item.Risk</td><td>@item.Decision</td><td>@item.CreatedAt</td></tr>
}
</tbody></table></div></div>
@if (Model.Page > 0) { <a class="btn btn-secondary" asp-route-page="@(Model.Page - 1)">@Localizer["Previous"]</a> }
@if (Model.HasNextPage) { <a class="btn btn-secondary" asp-route-page="@(Model.Page + 1)">@Localizer["Next"]</a> }
