@model Aiursoft.DMS.Models.DmsViewModels.DmsViewModel
@using Aiursoft.DMS.Models.DmsViewModels
<h1>@Localizer["Workflow history"]</h1>
<form method="get" class="mb-3">
    <input name="machineId" type="hidden" value="@Model.MachineId" />
    <label for="clusterId" class="form-label">@Localizer["Cluster"]</label>
    <select id="clusterId" name="clusterId" class="form-select mb-2">
        <option value="">@Localizer["All clusters"]</option>
        @foreach (var cluster in Model.Clusters)
        {
            <option value="@cluster.Id" selected="@(Model.ClusterId == cluster.Id)">@cluster.Name</option>
        }
    </select>
    <label for="definition" class="form-label">@Localizer["Workflow type"]</label>
    <input id="definition" name="definition" class="form-control mb-2" value="@Model.Definition" />
    <div class="form-check mb-2">
        <input id="clusterWorkflowsOnly" name="clusterWorkflowsOnly" type="checkbox" value="true" checked="@Model.ClusterWorkflowsOnly" class="form-check-input" />
        <label for="clusterWorkflowsOnly" class="form-check-label">@Localizer["Cluster workflows only"]</label>
    </div>
    <button class="btn btn-primary">@Localizer["Filter"]</button>
</form>
<div class="card"><div class="card-body table-responsive"><table class="table"><thead><tr><th>@Localizer["Workflow"]</th><th>@Localizer["State"]</th><th>@Localizer["Cluster"]</th><th>@Localizer["Machine"]</th><th>@Localizer["Created"]</th></tr></thead><tbody>
@foreach (var run in Model.Runs)
{
    <tr><td><a asp-action="Operation" asp-route-id="@run.Id">@run.Definition</a><br /><small>@run.Id</small></td><td><span class="badge bg-@DmsViewModel.Color(run.State)">@run.State</span></td><td>@Model.Clusters.FirstOrDefault(c => c.Id == run.ClusterId)?.Name</td><td>@run.MachineId</td><td>@run.CreatedAt</td></tr>
}
</tbody></table></div></div>
@if (Model.Page > 0) { <a class="btn btn-secondary" asp-route-page="@(Model.Page - 1)" asp-route-machineId="@Model.MachineId" asp-route-definition="@Model.Definition" asp-route-clusterId="@Model.ClusterId" asp-route-clusterWorkflowsOnly="@Model.ClusterWorkflowsOnly">@Localizer["Previous"]</a> }
@if (Model.HasNextPage) { <a class="btn btn-secondary" asp-route-page="@(Model.Page + 1)" asp-route-machineId="@Model.MachineId" asp-route-definition="@Model.Definition" asp-route-clusterId="@Model.ClusterId" asp-route-clusterWorkflowsOnly="@Model.ClusterWorkflowsOnly">@Localizer["Next"]</a> }
