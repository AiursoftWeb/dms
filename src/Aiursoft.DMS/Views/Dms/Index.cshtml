@model Aiursoft.DMS.Models.DmsViewModels.DmsViewModel
<h1>@Localizer["Machines"]</h1>
<div class="card"><div class="card-body table-responsive">
<table class="table"><thead><tr><th>@Localizer["Machine"]</th><th>@Localizer["Agent version"]</th><th>@Localizer["Status"]</th><th>@Localizer["Last seen"]</th></tr></thead><tbody>
@foreach (var machine in Model.Machines)
{
    <tr><td><a asp-action="Machine" asp-route-id="@machine.Id">@machine.Name</a><br /><small>@machine.Id</small></td><td>@machine.AgentVersion</td><td>@(machine.Disabled ? Localizer["Disabled"] : machine.LastSeen > DateTime.UtcNow.AddSeconds(-45) ? Localizer["Online"] : Localizer["Offline"])</td><td>@machine.LastSeen</td></tr>
}
</tbody></table>
@if (Model.Machines.Count == 0) { <p>@Localizer["No machines have joined. Use a join key to request Agent registration."]</p> }
</div></div>
