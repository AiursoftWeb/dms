@using Aiursoft.DMS.Services.Dms
@inject Microsoft.Extensions.Localization.IStringLocalizer<Aiursoft.DMS.Services.ViewModelArgsInjector> NavigationText
@using Aiursoft.DMS.Contracts
@using Aiursoft.DMS.Models.DmsViewModels
@using System.Globalization
@using System.Text.Json
@model LockboxViewModel
@{
    var item = Model.Item;
    var status = Model.Status;
    var snapshot = Model.Snapshot;
    var upgrade = Model.AgentUpgrade;
    var needsResubmission = upgrade?.RequiresResubmission == true;
    var pending = status.Decision == DecisionState.Pending && !needsResubmission;
    var notice = Model.Notice switch
    {
        AgentReleaseStore.PreviewChangedMessage => @Localizer["The current Agent package changed again. Review it before submitting."].Value,
        AgentReleaseStore.OriginalAvailableMessage => @Localizer["The original Agent package is available again. Review the original request."].Value,
        AgentReleaseStore.UnavailableMessage => @Localizer["The Agent package is temporarily unavailable. Try again later."].Value,
        _ => Model.Notice
    };
    var decision = needsResubmission ? @Localizer["Needs a new request"] : status.Decision switch
    {
        DecisionState.Pending => @Localizer["Awaiting approval"],
        DecisionState.Approved when Model.ExecutionState is RunState.Queued or RunState.Offered or RunState.Accepted =>
            @Localizer["Approved · Waiting to run"],
        DecisionState.Approved => @Localizer["Approved"],
        DecisionState.Denied => @Localizer["Denied"],
        _ => @Localizer["Withdrawn"]
    };
    var decisionTone = status.Decision switch
    {
        DecisionState.Pending => "warning",
        DecisionState.Approved => "success",
        DecisionState.Denied => "danger",
        _ => "secondary"
    };
    var risk = item.Risk switch
    {
        RiskLevel.Open => @Localizer["Open workflow"],
        RiskLevel.Safe => @Localizer["Safe workflow"],
        RiskLevel.Low => @Localizer["Low risk"],
        RiskLevel.Medium => @Localizer["Medium risk"],
        RiskLevel.High => @Localizer["High risk"],
        _ => @Localizer["Very high risk"]
    };
    var riskTone = item.Risk switch
    {
        RiskLevel.High or RiskLevel.VeryHigh => "danger",
        RiskLevel.Medium => "warning",
        _ => "secondary"
    };
    var parameters = snapshot.Input.ValueKind == JsonValueKind.Object
        ? snapshot.Input.EnumerateObject().ToArray()
        : Array.Empty<JsonProperty>();
    const string timestampFormat = "yyyy-MM-dd'T'HH:mm:ss'Z'";
    var requestedAt = status.RequestedAt.ToString(timestampFormat, CultureInfo.InvariantCulture);
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/lockbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/styles/dms-workspace.css" asp-append-version="true" />
}

<div class="lockbox-review mx-auto">
    @if (Model.OwnRequestView)
    {
        <a class="lockbox-back" asp-controller="DmsAccess" asp-action="MyLockboxes"><i data-lucide="arrow-left" aria-hidden="true"></i> @LockboxText.Format(NavigationText[LockboxText.MyRequests].Value)</a>
    }
    else
    {
        <a class="lockbox-back" asp-controller="Dms" asp-action="Lockboxes"><i data-lucide="arrow-left" aria-hidden="true"></i> @LockboxText.Name</a>
    }

    @if (notice != null)
    {
        <div class="alert alert-warning" role="alert"><div class="alert-message">@notice</div></div>
    }

    <header class="card lockbox-header">
        <div class="card-body">
            <div class="lockbox-heading">
                <div class="lockbox-mark"><i data-lucide="workflow" aria-hidden="true"></i></div>
                <div>
                    @if (upgrade != null && snapshot.Targets.Count == 1 && Model.MachineNames.TryGetValue(snapshot.Targets[0], out var targetName))
                    {
                        <h1>@string.Format(CultureInfo.CurrentCulture, @Localizer["Upgrade the DMS Agent on {0}"].Value, targetName)</h1>
                    }
                    else
                    {
                        <h1><partial name="_DmsWorkflowName" model="item.Definition" /></h1>
                    }
                    @if (upgrade == null)
                    {
                        <code class="lockbox-definition">@item.Definition</code>
                    }
                </div>
                <div class="lockbox-badges">
                    <span class="lockbox-badge text-@(decisionTone)-emphasis bg-@(decisionTone)-subtle"><span class="lockbox-dot"></span>@decision</span>
                    <span class="lockbox-badge text-@(riskTone)-emphasis bg-@(riskTone)-subtle"><i data-lucide="shield" aria-hidden="true"></i>@risk</span>
                </div>
            </div>

            @if (needsResubmission)
            {
                <div class="alert alert-warning mb-0">
                    <div class="alert-message">
                        <p class="mb-2" role="status">@Localizer["The selected Agent package has been replaced. The upgrade has not started."]</p>
                        @if (Model.CanResubmit && upgrade?.Available is { } available)
                        {
                            <p class="mb-2">
                                @Localizer["Currently available Agent package"]
                                <strong>@string.Join(", ", available.Select(release => release.Version).Distinct())</strong>
                            </p>
                            <p class="mb-2">@Localizer["Review the current package and submit a new request for the same machines."]</p>
                            <form asp-controller="DmsAccess" asp-action="ResubmitAgentUpgrade" method="post">
                                <input type="hidden" name="id" value="@status.LockboxId" />
                                <input type="hidden" name="requestId" value="@Guid.NewGuid()" />
                                <input type="hidden" name="releaseIdentity" value="@AgentReleaseStore.Identity(available)" />
                                <button class="btn btn-primary" type="submit">@Localizer["Submit a new upgrade request"]</button>
                            </form>
                        }
                        else if (Model.CanWithdraw)
                        {
                            <p class="mb-0">@Localizer["Your current role does not allow you to request this upgrade."]</p>
                        }
                        else
                        {
                            <p class="mb-2">@Localizer["The requester needs to submit a new upgrade request."]</p>
                            @if (!Model.OwnRequestView)
                            {
                                <a class="btn btn-outline-secondary" asp-controller="Dms" asp-action="Lockboxes">@Localizer["Back to approvals"]</a>
                            }
                        }
                    </div>
                </div>
            }

            @if (Model.PendingSshLeaseReadiness is { } sshReadiness)
            {
                <partial name="_DmsSshLeaseReadiness" model="sshReadiness" />
            }
            else if (Model.SshBaselineFailureMachine is { } sshMachine)
            {
                <partial name="_DmsSshLeaseFailure" model="sshMachine" />
            }

            <dl class="lockbox-context">
                <div>
                    <dt><i data-lucide="user" aria-hidden="true"></i>@LockboxText.Format(@Localizer["{0} requester"].Value)</dt>
                    <dd>@status.RequestedBy</dd>
                </div>
                <div>
                    <dt><i data-lucide="clock" aria-hidden="true"></i>@LockboxText.Format(@Localizer["{0} request time"].Value)</dt>
                    <dd><time datetime="@requestedAt" data-utc-now title="@requestedAt">@status.RequestedAt.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</time></dd>
                </div>
                <div>
                    <dt><i data-lucide="server" aria-hidden="true"></i>@Localizer["Target machines"]</dt>
                    <dd>
                        @if (snapshot.Targets.Count == 0)
                        {
                            <span class="text-body-secondary">@Localizer["No machine targets"]</span>
                        }
                        else
                        {
                            @if (snapshot.AllMachines)
                            {
                                <div class="small fw-normal mb-1">@Localizer["All enabled machines at submission"]</div>
                            }
                            <ul class="lockbox-targets list-unstyled mb-0">
                                @foreach (var id in snapshot.Targets)
                                {
                                    <li>
                                        @if (Model.MachineNames.TryGetValue(id, out var name))
                                        {
                                            @if (Model.CanViewOperations)
                                            {
                                                <a asp-controller="Dms" asp-action="Machine" asp-route-id="@id" title="@id">@name</a>
                                            }
                                            else
                                            {
                                                <span>@name</span>
                                            }
                                        }
                                        else
                                        {
                                            <code>@id</code>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(item.Reason))
            {
                <div class="lockbox-reason">
                    <div class="lockbox-label">@LockboxText.Format(@Localizer["{0} request reason"].Value)</div>
                    <p class="mb-0">@item.Reason</p>
                </div>
            }
        </div>
    </header>

    <div class="lockbox-grid">
        @if (!needsResubmission)
        {
            <div class="lockbox-request">
                @if (Model.AptPlans is { } aptPlans)
                {
                    <section class="card lockbox-panel" aria-labelledby="lockbox-apt-plan-heading">
                        <div class="card-body">
                            <h2 id="lockbox-apt-plan-heading"><i data-lucide="package" aria-hidden="true"></i>@Localizer["APT package plan"]</h2>
                            @foreach (var machine in snapshot.Targets)
                            {
                                <details class="mb-2" open="@(snapshot.Targets.Count == 1)">
                                    <summary>@Model.MachineNames.GetValueOrDefault(machine, machine.ToString())</summary>
                                    @if (!aptPlans.TryGetValue(machine, out var plan))
                                    {
                                        <p class="text-danger">@Localizer["The preview is unavailable for this machine."]</p>
                                    }
                                    else if (plan.Changes.Length == 0)
                                    {
                                        <p class="text-body-secondary mb-1">@Localizer["No package changes planned."]</p>
                                    }
                                    else
                                    {
                                        <ul class="mb-2">
                                            @foreach (var change in plan.Changes)
                                            {
                                                <li>
                                                    @(change.Action switch
                                                    {
                                                        AptPackageAction.Install => Localizer["Install"],
                                                        AptPackageAction.Upgrade => Localizer["Upgrade"],
                                                        AptPackageAction.Remove => Localizer["Remove"],
                                                        _ => Localizer["Remove package and configuration"]
                                                    })
                                                    <code class="text-break">@change.Package</code>
                                                    <span class="text-break">@(change.FromVersion ?? "—") → @(change.ToVersion ?? "—")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (plan is { AdditionalUpgradesRequiringReview.Length: > 0 })
                                    {
                                        <p class="text-body-secondary mb-1">@Localizer["Additional upgrades in a plan that would remove packages"]</p>
                                        <ul class="mb-2">
                                            @foreach (var change in plan.AdditionalUpgradesRequiringReview)
                                            {
                                                <li><code class="text-break">@change.Package</code> <span class="text-break">@change.FromVersion → @change.ToVersion</span></li>
                                            }
                                        </ul>
                                    }
                                </details>
                            }
                        </div>
                    </section>
                }
                else if (upgrade != null)
                {
                    <section class="card lockbox-panel" aria-labelledby="lockbox-agent-package-heading">
                        <div class="card-body">
                            <h2 id="lockbox-agent-package-heading"><i data-lucide="package" aria-hidden="true"></i>
                                @Localizer["Requested Agent package"]
                            </h2>
                            <dl class="lockbox-parameters mb-0">
                                @foreach (var release in upgrade.Requested)
                                {
                                    <div><dt>@release.Architecture</dt><dd>@release.Version</dd></div>
                                }
                            </dl>
                            @if (pending && upgrade.Available == null && Model.Notice != AgentReleaseStore.UnavailableMessage)
                            {
                                <p class="lockbox-note">@Localizer["The Agent package is temporarily unavailable. Try again later."]</p>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <section class="card lockbox-panel" aria-labelledby="lockbox-command-heading">
                        <div class="card-body">
                            <h2 id="lockbox-command-heading"><i data-lucide="terminal" aria-hidden="true"></i>@Localizer["Command"]</h2>
                            @if (snapshot.Command is { } command)
                            {
                                <div class="lockbox-terminal" data-lockbox-terminal>
                                    <div class="lockbox-terminal-bar">
                                        <span>@(command.IsEquivalentCli ? @Localizer["Equivalent DMS command"] : @LockboxText.Format(@Localizer["Docker command in this {0} request"].Value))</span>
                                        <button class="btn btn-sm lockbox-copy" type="button" data-copy-command hidden>
                                            <i data-lucide="copy" aria-hidden="true"></i><span>@Localizer["Copy"]</span>
                                        </button>
                                        <span hidden data-key="command-copied">@Localizer["Command copied"]</span>
                                    </div>
                                    <pre tabindex="0"><code data-command><span>@command.Invocation</span>@command.Separator@command.Arguments</code></pre>
                                </div>
                                @if (command.IsEquivalentCli)
                                {
                                    <p class="lockbox-note">@Localizer["Reconstructed from the saved input and target machines."]</p>
                                }
                            }
                            else if (Model.InputArtifacts.Count != 0 &&
                                     (item.Definition == OperationsWorkflows.SystemExecuteScript.Name ||
                                      item.Definition == OperationsWorkflows.DatabaseQuerySql.Name ||
                                      item.Definition == OperationsWorkflows.DatabaseExecuteSql.Name))
                            {
                                <p class="text-body-secondary mb-2">@Localizer["Review the exact contents submitted for execution."]</p>
                                @foreach (var artifact in Model.InputArtifacts)
                                {
                                    <a class="lockbox-artifact-command" asp-controller="Dms" asp-action="Artifact" asp-route-id="@artifact.Id">
                                        <i data-lucide="file-code" aria-hidden="true"></i>@artifact.Name
                                    </a>
                                }
                            }
                            else
                            {
                                <div class="lockbox-terminal">
                                    <div class="lockbox-terminal-bar">@LockboxText.Format(@Localizer["Saved {0} request"].Value)</div>
                                    <pre><code><span>POST /api/v1/dms/lockboxes</span>
Workflow: @item.Definition</code></pre>
                                </div>
                                <p class="lockbox-note">@LockboxText.Format(@Localizer["Use the frozen parameters below to review this {0} request."].Value)</p>
                            }
                        </div>
                    </section>

                    <section class="card lockbox-panel" aria-labelledby="lockbox-parameters-heading">
                        <div class="card-body">
                            <h2 id="lockbox-parameters-heading"><i data-lucide="sliders-horizontal" aria-hidden="true"></i>@Localizer["Parameters"]</h2>
                            @if (parameters.Length != 0)
                            {
                                <dl class="lockbox-parameters mb-0">
                                    @foreach (var parameter in parameters)
                                    {
                                        <div>
                                            <dt>@(item.Definition == WorkflowNames.PullerForceUpdate ? parameter.Name switch
                                            {
                                                "Image" => @Localizer["Image"].Value,
                                                "Puller" => @Localizer["Puller"].Value,
                                                "ImageScope" => @Localizer["Image scope"].Value,
                                                _ => parameter.Name
                                            } : parameter.Name)</dt>
                                            <dd><code>@LockboxSnapshot.Format(parameter.Value)</code></dd>
                                        </div>
                                    }
                                </dl>
                            }
                            else if (snapshot.Input.ValueKind != JsonValueKind.Object)
                            {
                                <pre class="lockbox-json mb-0">@LockboxSnapshot.Format(snapshot.Input)</pre>
                            }
                            else
                            {
                                <p class="text-body-secondary mb-0">@Localizer["This workflow takes no parameters."]</p>
                            }
                            @if (Model.InputArtifacts.Count != 0)
                            {
                                <h3 class="lockbox-label mt-4">@Localizer["Frozen input files"]</h3>
                                <ul class="lockbox-files list-unstyled mb-0">
                                    @foreach (var artifact in Model.InputArtifacts)
                                    {
                                        <li>
                                            <a asp-controller="Dms" asp-action="Artifact" asp-route-id="@artifact.Id">@artifact.Name</a>
                                            <small>(@artifact.Length @Localizer["bytes"])</small>
                                            <code class="d-block small">SHA256 @artifact.Sha256</code>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </section>
                }
            </div>

            <section class="card lockbox-panel lockbox-approval" aria-labelledby="lockbox-approval-heading">
                <div class="card-body">
                    @if (pending)
                    {
                        <h2 id="lockbox-approval-heading"><i data-lucide="shield-check" aria-hidden="true"></i>@Localizer["Who can approve"]</h2>
                        @if (status.EligibleApprovers.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@Localizer["No eligible approvers right now."]</p>
                        }
                        else
                        {
                            <ul class="lockbox-people list-unstyled mb-0">
                                @foreach (var approver in status.EligibleApprovers)
                                {
                                    <li><span class="lockbox-person-mark"><i data-lucide="user" aria-hidden="true"></i></span><span>@approver</span></li>
                                }
                            </ul>
                        }
                        @if (Model.CanDecide)
                        {
                            <form asp-controller="Dms" asp-action="Decide" method="post" class="lockbox-decision-form">
                                <input type="hidden" name="id" value="@status.LockboxId" />
                                <label class="form-label" for="reason">@Localizer["Decision reason"]</label>
                                <textarea id="reason" class="form-control" name="reason" maxlength="2000" rows="3"></textarea>
                                <div class="lockbox-actions">
                                    <button class="btn btn-success" type="submit" name="approve" value="true">@Localizer["Approve"]</button>
                                    <button class="btn btn-outline-danger" type="submit" name="approve" value="false">@Localizer["Deny"]</button>
                                </div>
                            </form>
                        }
                        @if (Model.CanWithdraw)
                        {
                            <div class="lockbox-decision-form"><partial name="_WithdrawLockbox" model="item" /></div>
                        }
                    }
                    else
                    {
                        <h2 id="lockbox-approval-heading"><i data-lucide="shield-check" aria-hidden="true"></i>@Localizer["Decision"]</h2>
                        <p class="fw-semibold mb-1">@(status.Automatic ? @Localizer["Automatic approval"].Value : status.DecidedBy ?? decision.Value)</p>
                        @if (status.DecidedAt is { } decidedAt)
                        {
                            var decidedTimestamp = decidedAt.ToString(timestampFormat, CultureInfo.InvariantCulture);
                            <time class="small text-body-secondary" datetime="@decidedTimestamp" data-utc-now title="@decidedTimestamp">@decidedAt.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</time>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.DecisionReason))
                        {
                            <p class="lockbox-decision-reason mb-0">@item.DecisionReason</p>
                        }
                    }
                    @if (status.Decision == DecisionState.Approved)
                    {
                        <div class="lockbox-decision-form">
                            <h3 class="lockbox-label">@Localizer["Execution status"]</h3>
                            @if (Model.ExecutionState is { } state)
                            {
                                <partial name="_DmsRunStatus" model="state" />
                            }
                            else
                            {
                                <p class="text-body-secondary mb-0">@Localizer["Execution status is unavailable."]</p>
                            }
                            @if (Model.CanViewOperations && status.WorkflowId != null)
                            {
                                <div class="mt-2">
                                    <a asp-controller="Dms" asp-action="Operation" asp-route-id="@status.WorkflowId">
                                        <i data-lucide="activity" aria-hidden="true"></i>@Localizer["View workflow execution"]
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }
        else if (Model.CanWithdraw)
        {
            <div class="lockbox-request"><partial name="_WithdrawLockbox" model="item" /></div>
        }

        <details class="card lockbox-audit">
            <summary>@LockboxText.Format(@Localizer["{0} request identifiers and raw payload"].Value)</summary>
            <div class="card-body pt-0">
                <dl class="lockbox-parameters">
                    <div><dt>@LockboxText.Format(@Localizer["{0} ID"].Value)</dt><dd><code>@status.LockboxId</code></dd></div>
                    <div><dt>@LockboxText.Format(@Localizer["{0} requester ID"].Value)</dt><dd><code>@item.RequesterId</code></dd></div>
                    @if (Model.CanViewOperations && item.ApproverId != null)
                    {
                        <div><dt>@Localizer["Approver ID"]</dt><dd><code>@item.ApproverId</code></dd></div>
                    }
                    <div><dt>@Localizer["Workflow version"]</dt><dd><code>@item.Version</code></dd></div>
                    @if (snapshot.Targets.Count != 0)
                    {
                        <div><dt>@Localizer["Target machines"]</dt><dd><code>@string.Join(", ", snapshot.Targets)</code></dd></div>
                    }
                </dl>
                <pre class="lockbox-json">@snapshot.RequestJson</pre>
                @if (needsResubmission)
                {
                    <h3 class="lockbox-label">@Localizer["Currently available Agent package"]</h3>
                    <pre class="lockbox-json">@LockboxSnapshot.Format(JsonSerializer.SerializeToElement(upgrade!.Available))</pre>
                }
                @if (Model.CanViewOperations && item.LegacyApprovalWorkflowId != null)
                {
                    <a asp-controller="Dms" asp-action="Operation" asp-route-id="@item.LegacyApprovalWorkflowId">@Localizer["Historical approval workflow"]</a>
                }
            </div>
        </details>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/lockbox.js" asp-append-version="true"></script>
}
