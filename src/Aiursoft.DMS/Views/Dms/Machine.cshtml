@using System.Globalization
@using Aiursoft.DMS.Contracts
@using Aiursoft.DMS.Models.DmsViewModels
@using Aiursoft.DMS.Services.Dms
@using Aiursoft.WebTools
@model Aiursoft.DMS.Models.DmsViewModels.DmsMachineViewModel
@{
    var machine = Model.Machine;
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/dms-workspace.css" asp-append-version="true" />
}

<div class="dms-workspace mx-auto">
    <nav class="dms-path" aria-label="@Localizer["Machines"]">
        <a asp-action="Index"><i data-lucide="arrow-left" aria-hidden="true"></i> @Localizer["Back to machines"]</a>
    </nav>
    <header class="dms-page-heading">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="mb-0">@machine.Name</h1>
            <partial name="_DmsMachineConnection" model="machine.Connection" />
        </div>
        <a asp-action="Operations" asp-route-machineId="@machine.Id" class="btn btn-outline-secondary"><i data-lucide="history" aria-hidden="true"></i> @Localizer["Workflow history"]</a>
    </header>

    <section class="card dms-detail-card" id="ssh-management" aria-labelledby="ssh-heading">
        <div class="card-body">
            <h2 id="ssh-heading"><i data-lucide="key-round" aria-hidden="true"></i> @Localizer["SSH management"]</h2>
            <partial name="_DmsMachineSsh" model="Model.SshAccess" />
            @if (Model.SshStateChanged)
            {
                <p class="text-warning-emphasis mt-3">@Localizer["The SSH state changed. Review the current status before submitting a new request."]</p>
            }
            <div class="mt-3"><partial name="_DmsSshLeaseReadiness" model="Model.SshLeaseReadiness" /></div>
            <div class="d-flex flex-wrap gap-3 mt-3">
                <a asp-action="Operations" asp-route-machineId="@machine.Id" asp-route-definition="@OperationsWorkflows.SshDisable.Name">
                    @Localizer["Disable SSH history"]
                </a>
                <a asp-action="Operations" asp-route-machineId="@machine.Id" asp-route-definition="@OperationsWorkflows.SshCheckLease.Name">
                    @Localizer["SSH lease-check history"]
                </a>
                @if (Model.SshLeaseReadiness == SshLeaseReadiness.Unknown)
                {
                    <a asp-action="Operations" asp-route-machineId="@machine.Id" asp-route-definition="@WorkflowNames.AgentUpgrade">
                        @Localizer["Agent upgrade history"]
                    </a>
                }
            </div>
            @if (Model.SshLeaseReadiness is SshLeaseReadiness.OrdinaryOpen or SshLeaseReadiness.NeedsSetup)
            {
                @if (Model.CanRequestSshDisable)
                {
                    <details class="mt-3">
                        <summary class="fw-semibold">@Localizer["Request Disable SSH"]</summary>
                        <form asp-action="RequestSshDisable" asp-route-id="@machine.Id" method="post" class="mt-3">
                            <input type="hidden" name="requestId" value="@Guid.NewGuid()" />
                            <label class="form-label" for="ssh-disable-reason">@Localizer["Reason"]</label>
                            <input class="form-control" name="reason" id="ssh-disable-reason" required maxlength="2000" />
                            <div class="form-check mt-3">
                                <input type="checkbox" class="form-check-input" name="confirm" id="ssh-disable-confirm" value="true" required />
                                <label class="form-check-label" for="ssh-disable-confirm">@Localizer["Disable SSH can disconnect sessions and revoke any lease present when it runs."]</label>
                            </div>
                            <button class="btn btn-warning mt-3" type="submit">@LockboxText.Format(@Localizer["Submit {0} request"].Value)</button>
                        </form>
                    </details>
                }
                else
                {
                    <p class="form-text mb-0">@Localizer["Requesting Disable SSH requires DMS permission to submit Medium risk workflows."]</p>
                }
            }
            @if (Model.CanRequestSshLease && Model.SshLeaseReadiness == SshLeaseReadiness.Ready)
            {
                <p class="mt-3 mb-2">@Localizer["Verify your personal SSH keys before requesting access. The CLI uses all your verified keys by default."]</p>
                <a asp-controller="SshKeys" asp-action="Index" class="fw-semibold">@Localizer["SSH public keys"]</a>
                <pre class="dms-payload mt-2 mb-0" tabindex="0"><code>dms machine ssh temp-allow-ssh --machine-id @machine.Id --reason "$REASON"</code></pre>
                <p class="form-text mb-0">@Localizer["Use --key-id to select a single verified key."]</p>
            }
        </div>
    </section>

    <div class="row g-3 mb-3">
        <section class="col-lg-5" aria-labelledby="connection-heading">
            <div class="card dms-detail-card h-100 mb-0">
                <div class="card-body">
                    <h2 id="connection-heading"><i data-lucide="activity" aria-hidden="true"></i> @Localizer["Agent connection"]</h2>
                    <dl class="dms-machine-facts">
                        <div>
                            <dt>@Localizer["Last seen"]</dt>
                            <dd>
                                @if (machine.LastSeen is { } lastSeen)
                                {
                                    var timestamp = lastSeen.ToHtmlDateTime();
                                    <time datetime="@timestamp" data-utc-time="@timestamp">@lastSeen.ToString("u", CultureInfo.InvariantCulture)</time>
                                }
                                else
                                {
                                    <span>@Localizer["No heartbeat received"]</span>
                                }
                            </dd>
                        </div>
                        <div>
                            <dt>@Localizer["Agent version"]</dt>
                            <dd>@(string.IsNullOrEmpty(machine.AgentVersion) ? "—" : machine.AgentVersion)</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </section>

        <section class="col-lg-7" aria-labelledby="baseline-heading">
            <div class="card dms-detail-card h-100 mb-0">
                <div class="card-body">
                    <h2 id="baseline-heading"><i data-lucide="shield-check" aria-hidden="true"></i> @Localizer["Scheduled security baseline"]</h2>
                    <p class="mb-2"><partial name="_DmsScheduledSshStatus" model="@(machine.Connection != MachineConnection.Disabled)" /></p>
                    @if (Model.BaselineRun is { } run)
                    {
                        var runTime = run.FinishedAt ?? run.StartedAt ?? run.CreatedAt;
                        var timestamp = runTime.ToHtmlDateTime();
                        <dl class="dms-machine-facts">
                            <div>
                                <dt>@Localizer["Latest execution"]</dt>
                                <dd><partial name="_DmsRunStatus" model="run.State" /></dd>
                            </div>
                            <div>
                                <dt>@(run.FinishedAt.HasValue ? @Localizer["Finished"] : run.StartedAt.HasValue ? @Localizer["Started"] : @Localizer["Created"])</dt>
                                <dd><time datetime="@timestamp" data-utc-time="@timestamp">@runTime.ToString("u", CultureInfo.InvariantCulture)</time></dd>
                            </div>
                        </dl>
                        @if (Model.BaselineSummary is { } summary)
                        {
                            <p class="text-body-secondary mt-3 mb-0">@summary</p>
                        }
                        <div class="d-flex flex-wrap gap-3 mt-3">
                            <a asp-action="Operation" asp-route-id="@run.Id" class="fw-semibold">@Localizer["View execution"]</a>
                            <a asp-action="Operations" asp-route-machineId="@machine.Id" asp-route-definition="@WorkflowNames.ApplySecurityBaseline" asp-route-origin="@WorkflowOrigin.Automatic" asp-route-rootOnly="true">@Localizer["Baseline history"]</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">@Localizer["No scheduled baseline execution is recorded for this machine."]</p>
                    }
                </div>
            </div>
        </section>
    </div>

    <details class="card dms-details">
        <summary>@Localizer["Machine ID"]</summary>
        <div class="px-3 pb-3"><code>@machine.Id</code></div>
    </details>
</div>
