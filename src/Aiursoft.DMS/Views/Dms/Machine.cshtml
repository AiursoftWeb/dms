@using System.Globalization
@model Aiursoft.DMS.Models.DmsViewModels.DmsMachineViewModel
@{
    var machine = Model.Machine;
}

<div class="row">
    <div class="col-xl-9">
        <a asp-action="Index" class="d-inline-block mb-3">@Localizer["Back to machines"]</a>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <h1 class="mb-0 text-break">@machine.Name</h1>
            <a asp-action="Operations" asp-route-machineId="@machine.Id" class="btn btn-outline-primary">@Localizer["Workflow history"]</a>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Localizer["Connection status"]</dt>
                    <dd class="col-sm-8">
                        @if (machine.Disabled)
                        {
                            <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                        }
                        else if (machine.LastSeen > DateTime.UtcNow.AddSeconds(-45))
                        {
                            <span class="badge bg-success">@Localizer["Online"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["Offline"]</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Agent @Localizer["Version"]</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(machine.AgentVersion) ? "—" : machine.AgentVersion)</dd>
                    <dt class="col-sm-4">@Localizer["Last seen"]</dt>
                    <dd class="col-sm-8">@(machine.LastSeen?.ToString("u", CultureInfo.InvariantCulture) ?? "—")</dd>
                    <dt class="col-sm-4">@Localizer["Machine ID"]</dt>
                    <dd class="col-sm-8 mb-0 text-break"><code>@machine.Id</code></dd>
                </dl>
            </div>
        </div>
        @if (Model.CanRotateAgentKey)
        {
            <details class="card">
                <summary class="card-header fw-semibold">@Localizer["Advanced actions"]</summary>
                <div class="card-body">
                    <p>@Localizer["Replace the connection key if it has been lost or exposed. The Agent will need the new key to connect to DMS."]</p>
                    <a asp-controller="DmsAccess" asp-action="RotateAgentKey" asp-route-id="@machine.Id" class="btn btn-outline-danger">@Localizer["Replace the Agent connection key"]</a>
                </div>
            </details>
        }
    </div>
</div>
