@using Aiursoft.DMS.Models.DmsViewModels
@model SshLeaseReadiness

<div class="alert alert-@(Model == SshLeaseReadiness.Ready ? "success" : "warning") mb-0">
    <div class="alert-message">
        @switch (Model)
        {
            case SshLeaseReadiness.Ready:
                <strong>@Localizer["Temporary SSH is ready to request"]</strong>
                break;
            case SshLeaseReadiness.OrdinaryOpen:
                <strong>@Localizer["Ordinary SSH is still listening"]</strong>
                <p class="mb-0">@Localizer["To switch this machine to temporary SSH, run Disable SSH in DMS first."]</p>
                break;
            case SshLeaseReadiness.NeedsSetup:
                <strong>@Localizer["DMS has not verified SSH shutdown"]</strong>
                <p class="mb-0">@Localizer["Review the Disable SSH workflow result in DMS before requesting another lease."]</p>
                break;
            case SshLeaseReadiness.InUse:
                <strong>@Localizer["A temporary SSH lease is active"]</strong>
                <p class="mb-0">@Localizer["Wait for the current lease to end before requesting another one."]</p>
                break;
            case SshLeaseReadiness.AgentDisconnected:
                <strong>@Localizer["The Agent is disconnected"]</strong>
                <p class="mb-0">@Localizer["DMS can check SSH when the Agent reconnects."]</p>
                break;
            default:
                <strong>@Localizer["DMS has no recent SSH observation"]</strong>
                <p class="mb-0">@Localizer["Check the SSH lease history and the Agent version in DMS."]</p>
                break;
        }
    </div>
</div>
