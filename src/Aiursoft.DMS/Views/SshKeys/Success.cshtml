@model Aiursoft.DMS.Models.DmsViewModels.SshKeyVerificationViewModel

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 text-success mb-3">@Localizer["SSH public key added"]</h1>
                <p>@Localizer["This key is verified and ready to use when requesting temporary SSH access."]</p>
                <div class="border rounded p-3 mb-4 text-break">
                    <h2 class="h6 mb-2">@Model.Key.Name</h2>
                    <div class="small text-body-secondary">@Localizer["Fingerprint"] <code>@Model.Key.Fingerprint</code></div>
                    <div class="small text-body-secondary">@Localizer["Key ID"] <code>@Model.Key.Id</code></div>
                </div>
                <a asp-action="Index" class="btn btn-primary">@Localizer["Done"]</a>
            </div>
        </div>
    </div>
</div>
