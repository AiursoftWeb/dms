@model Aiursoft.DMS.Models.DmsViewModels.SshKeysViewModel

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="mb-0">@Localizer["SSH public keys"]</h1>
    @if (Model.PendingId is Guid pendingId)
    {
        <a asp-action="Verify" asp-route-id="@pendingId" class="btn btn-primary">@Localizer["Resume adding a key"]</a>
    }
    else if (Model.Keys.Count < 3)
    {
        <a asp-action="Add" class="btn btn-primary">@Localizer["Add SSH public key"]</a>
    }
</div>

@if (Model.Notice != null)
{
    <div class="alert alert-warning" role="alert"><div class="alert-message">@Localizer[Model.Notice]</div></div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0">@Localizer["Verified keys"]</h2>
        <span class="text-body-secondary">@Model.Keys.Count / 3</span>
    </div>
    @if (Model.Keys.Count == 0)
    {
        <div class="card-body text-body-secondary">@Localizer["No verified SSH public keys yet."]</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var key in Model.Keys)
            {
                <li class="list-group-item px-4 py-3">
                    <div class="row align-items-center gy-3">
                        <div class="col-sm">
                            <h3 class="h6 text-break mb-2">@key.Name</h3>
                            <div class="small text-body-secondary text-break">@Localizer["Fingerprint"] <code>@key.Fingerprint</code></div>
                            <div class="small text-body-secondary text-break">@Localizer["Key ID"] <code>@key.Id</code></div>
                        </div>
                        <div class="col-sm-auto">
                            <form asp-action="Revoke" method="post">
                                <input type="hidden" name="id" value="@key.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">@Localizer["Revoke"]</button>
                            </form>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
