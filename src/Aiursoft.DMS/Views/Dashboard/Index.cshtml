@using Aiursoft.DMS.Services.Dms
<h1>@Localizer["DMS"]</h1>
<p>@Localizer["Manage servers through approved workflows."]</p>
<div class="row">
<div class="col-md-4"><div class="card"><div class="card-body"><h2>@Localizer["Machines"]</h2><p>@Localizer["View Agent connectivity and machine history."]</p><a asp-controller="Dms" asp-action="Index" class="btn btn-primary">@Localizer["View machines"]</a></div></div></div>
<div class="col-md-4"><div class="card"><div class="card-body"><h2>@LockboxText.Name</h2><p>@LockboxText.Format(@Localizer["Review the operation, parameters and fixed targets in each {0} request."].Value)</p><a asp-controller="Dms" asp-action="Lockboxes" class="btn btn-primary">@LockboxText.Format(@Localizer["Review {0} requests"].Value)</a></div></div></div>
<div class="col-md-4"><div class="card"><div class="card-body"><h2>@Localizer["Workflow history"]</h2><p>@Localizer["Follow the callstack and inspect execution traces."]</p><a asp-controller="Dms" asp-action="Operations" class="btn btn-primary">@Localizer["View history"]</a></div></div></div>
</div>
