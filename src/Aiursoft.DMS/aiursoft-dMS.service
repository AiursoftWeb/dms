[Unit]
Description=Aiursoft DMS Web Application
After=network.target

[Service]
WorkingDirectory=/usr/share/aiursoft-dMS
ExecStart=/usr/bin/dotnet /usr/share/aiursoft-dMS/Aiursoft.DMS.dll --urls http://*:5000
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=aiursoft-dMS
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/lib/aiursoft-dMS

[Install]
WantedBy=multi-user.target
