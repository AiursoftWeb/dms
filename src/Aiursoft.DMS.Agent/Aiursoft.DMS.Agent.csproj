<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.26.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.DMS.Agent</AssemblyName>
    <RootNamespace>Aiursoft.DMS.Agent</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <!-- Installed services and upgrade helpers expect this command name. -->
    <ToolCommandName>dms-agent</ToolCommandName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Aiursoft</Company>
    <Product>Agent</Product>
    <Description>Enroll and run a DMS machine Agent.</Description>
    <PackageId>Aiursoft.DMS.Agent</PackageId>
    <PackageTags>dms agent workflows cli tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitlab.aiursoft.com/aiursoft/dms</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://gitlab.aiursoft.com/aiursoft/dms.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aiursoft.DMS.Workflows/Aiursoft.DMS.Workflows.csproj" />
    <ProjectReference Include="../Aiursoft.DMS.SDK/Aiursoft.DMS.SDK.csproj" />
    <PackageReference Include="Aiursoft.CommandFramework" Version="10.0.19" />
    <None Include="../../README.md" Pack="true" PackagePath="." />
  </ItemGroup>
</Project>
